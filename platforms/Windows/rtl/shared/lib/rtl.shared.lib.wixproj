<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <RuntimeAssemblyKind Condition=" '$(RuntimeAssemblyKind)' == '' ">shared</RuntimeAssemblyKind>
    <OutputName>rtl.dynamic.$(RuntimeAssemblyKind).$(ProductArchitecture)</OutputName>
    <OutputType>Library</OutputType>
    <BindFiles>true</BindFiles>
    <RuntimeLibraryConsumer Condition=" '$(RuntimeLibraryConsumer)' == '' ">standalone</RuntimeLibraryConsumer>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(RuntimeLibraryConsumer)\$(ProductArchitecture)\$(RuntimeAssemblyKind)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
</Project>
